# METADATA
# description: |
#   Defines the kind of symbols that may appear in a document.
# related_resources:
#   - https://microsoft.github.io/language-server-protocol/specifications/lsp/3.18/specification/#symbolKind
package regal.lsp.symbol

# METADATA
# description: Integer constant representing a file.
kind["file"] := 1

# METADATA
# description: Integer constant representing a module.
kind["module"] := 2

# METADATA
# description: Integer constant representing a namespace.
kind["namespace"] := 3

# METADATA
# description: Integer constant representing a package.
kind["package"] := 4

# METADATA
# description: Integer constant representing a class.
kind["class"] := 5

# METADATA
# description: Integer constant representing a method.
kind["method"] := 6

# METADATA
# description: Integer constant representing a property.
kind["property"] := 7

# METADATA
# description: Integer constant representing a field.
kind["field"] := 8

# METADATA
# description: Integer constant representing a constructor.
kind["constructor"] := 9

# METADATA
# description: Integer constant representing an enum.
kind["enum"] := 10

# METADATA
# description: Integer constant representing an interface.
kind["interface"] := 11

# METADATA
# description: Integer constant representing a function.
kind["function"] := 12

# METADATA
# description: Integer constant representing a variable.
kind["variable"] := 13

# METADATA
# description: Integer constant representing a constant.
kind["constant"] := 14

# METADATA
# description: Integer constant representing a string.
kind["string"] := 15

# METADATA
# description: Integer constant representing a number.
kind["number"] := 16

# METADATA
# description: Integer constant representing a boolean.
kind["boolean"] := 17

# METADATA
# description: Integer constant representing an array.
kind["array"] := 18

# METADATA
# description: Integer constant representing an object.
kind["object"] := 19

# METADATA
# description: Integer constant representing a key.
kind["key"] := 20

# METADATA
# description: Integer constant representing null.
kind["null"] := 21

# METADATA

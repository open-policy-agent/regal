{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-policy-agent/opa/ast/module",
  "$ref": "#/$defs/aggregate_input",
  "$defs": {
    "aggregate_input": {
      "properties": {
        "aggregates_internal": {
          "type": "object",
          "description": "Internal mapping of rule -> aggregate entries - not exposed in the API",
          "patternProperties": {
            "^[a-zA-Z_\\-\\.]$": {
              "type": "object",
              "description": "Object keyed by filename of the aggregate source",
              "patternProperties": {
                "^[a-z-/]$": {
                  "type": "array",
                  "description": "The aggregate rule key, like 'bugs/impossible-not', or 'common' for shared data",
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "ignore_directives": {
          "$ref": "#/$defs/ignore_directives"
        },
        "regal": {
          "$ref": "#/$defs/regal"
        }
      },
      "type": "object"
    },
    "aggregate": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignore_directives": {
      "type": "object"
    },
    "regal": {
      "properties": {
        "file": {
          "properties": {
            "name": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "type": "object"
        }
      },
      "type": "object",
      "required": [
        "file"
      ]
    }
  }
}
